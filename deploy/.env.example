# Copy to deploy/.env, then `chmod 600 .env`. Never commit .env.
# Percent-encode URL-reserved characters (@ : / ? # &) in passwords inside URLs.
# Validate the finished file with `./deploy.sh --check` (prints key names only).
# Generated by `deploy.sh --init-env`: NEXT_PUBLIC_SITE_URL, ADMIN_API_TOKEN,
# GUEST_KEY_SECRET, the Postgres passwords and URLs (local-db). The operator
# supplies: the site URL, the external-db URLs, Google credentials.

# Where the bind-mounted state lives on the VM (setup-host.sh creates it).
DEPLOY_ROOT=/opt/chuyennhahung
HTTP_PORT=80

# Public origin — baked at BUILD time (canonicals, hreflang, sitemap).
# http://<vm-ip> on a LAN; the https domain once TLS is in front.
NEXT_PUBLIC_SITE_URL=http://192.168.100.140
TRUST_PROXY_HEADERS=true

# >= 32 chars: openssl rand -base64 36. Empty or shorter: admin API answers 503.
ADMIN_API_TOKEN=
# >= 32 chars: openssl rand -hex 32 (ADR 0024). Empty or shorter: guest
# reviews and reports answer 503.
GUEST_KEY_SECRET=

# Optional: connections per app process (default 5).
# DATABASE_POOL_MAX=5

# --- Layout A: PostgreSQL on a SEPARATE VM (compose.app.external-db.yml) ---
# CA at ${DEPLOY_ROOT}/secrets/pg-ca.crt BEFORE `up`; SAN must contain <DB_IP>.
PLANNER_DATABASE_URL=postgres://cnh_app:CHANGE_ME@DB_IP:5432/cnh_planner?sslmode=verify-full&sslrootcert=/run/secrets/pg-ca.crt
# Optional (ADR 0013): content in Postgres too. Empty keeps the JSON file.
CONTENT_DATABASE_URL=

# --- Layout B: PostgreSQL in THIS stack (compose.app.local-db.yml) ---
# Use these instead of the two URLs above:
#   POSTGRES_ADMIN_USER=postgres   (optional, this is the default)
#   POSTGRES_ADMIN_PASSWORD=<openssl rand -base64 24>
#   CNH_APP_PASSWORD=<openssl rand -hex 24>
#   PLANNER_DATABASE_URL=postgres://cnh_app:<CNH_APP_PASSWORD>@postgres:5432/cnh_planner
#   CONTENT_DATABASE_URL=postgres://cnh_app:<CNH_APP_PASSWORD>@postgres:5432/cnh_content

# Optional Google sign-in (needs https; see usage.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Compose default is false (the app's own default is true).
GOOGLE_SIGNUP_ENABLED=false
# The OAuth callback is derived from NEXT_PUBLIC_SITE_URL; GOOGLE_REDIRECT_URI
# is deliberately not passed to the container (docs/usage.md).

# Checkout of the repository, relative to deploy/ (default: this checkout).
APP_SRC=..
# Set by deploy.sh for the automatic path (ADR 0016); leave unset for a local build.
# APP_IMAGE=ghcr.io/<owner>/chuyennhahung-app
APP_IMAGE_TAG=latest

# Memory caps per container (defaults shown).
# APP_MEM_LIMIT=768m
# POSTGRES_MEM_LIMIT=512m

# Only with compose.postgres-lan.yml (QC access over the LAN, docs/deploy-db-access.md):
# the VM's LAN IP that publishes 15432. Never 0.0.0.0.
# DB_BIND_ADDR=
